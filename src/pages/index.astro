---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import Icon from '../components/Icon.astro';
import { getArticles, getNav, articleUrl, categoryUrl } from '../lib/articles';
import { popular, site } from '../data/site';
import { faqLd, organization, websiteLd } from '../lib/seo';

const nav = await getNav();
const ids = new Set((await getArticles()).map((a) => a.id));
const missing = popular.filter((c) => !ids.has(c.article));
if (missing.length) {
  throw new Error(`src/data/site.ts: popular topic ${missing.map((c) => `"${c.label}" → "${c.article}"`).join(', ')} — there is no such article (file name without .mdx in src/content/articles/)`);
}
const chips = popular;
const faqEntries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const faq = await Promise.all(faqEntries.map(async (e) => ({ q: e.data.question, id: e.id, Content: (await render(e)).Content })));
const faqHtml = faqEntries.map((e) => {
  if (!e.rendered?.html) throw new Error(`src/data/faq/${e.id}.md: the answer is empty`);
  return { q: e.data.question, html: e.rendered.html };
});
const jsonLd = [websiteLd, organization, faqLd(faqHtml)];
---
<Base home jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-inner">
      <h1 tabindex="-1">How can we <span class="grad">help</span>?</h1>
      <p>Answers, guides and troubleshooting — all in one place.</p>
      <SearchBox variant="hero" />
      {chips.length > 0 && (
        <ul class="hero-chips" aria-label="Popular topics">
          {chips.map((c) => <li><a href={articleUrl(c.article)}>{c.label}</a></li>)}
        </ul>
      )}
    </div>
  </section>

  <section class="cats-wrap" aria-labelledby="topics-h">
    <h2 class="sr" id="topics-h">Topics</h2>
    <ul class="cats-grid">
      {nav.map((c) => (
        <li><a class="hcard" href={categoryUrl(c.slug)}><CategoryIcon category={c} /><div><h3>{c.title}</h3><p>{c.description}</p></div></a></li>
      ))}
    </ul>
  </section>

  <section class="faq-wrap" aria-labelledby="faq-h">
    <h2 id="faq-h">Frequently asked questions</h2>
    {faq.map(({ q, id, Content }) => (
      <div class="faq-item">
        <h3><button type="button" class="faq-q" aria-expanded="false" aria-controls={`faq-${id}`}><span>{q}</span><Icon name="chevD" /></button></h3>
        <div class="faq-a" id={`faq-${id}`} hidden><Content /></div>
      </div>
    ))}
  </section>

  <section class="home-contact" aria-labelledby="contact-h">
    <div class="home-contact-inner">
      <h2 id="contact-h">Still need help?</h2>
      <p>We read every email and get back to you as soon as we can.</p>
      <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    </div>
  </section>
</Base>
