---
import '@fontsource/onest/400.css';
import '@fontsource/onest/500.css';
import '@fontsource/onest/600.css';
import '@fontsource/onest/700.css';
import '@fontsource/onest/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../data/site';

interface Props {
  /** page title without the site name; empty on the home page */
  title?: string;
  description?: string;
  home?: boolean;
  /** current category slug (for the menu) */
  category?: string;
  /** current article id (highlighted in the menu) */
  active?: string;
  /** `noindex, follow` — drafts, hidden articles, the 404 page */
  noindex?: boolean;
  /** false on the 404 page: no canonical link and no og:url */
  canonical?: boolean;
  /** structured data (schema.org), one object or several */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title, description = site.description, home = false, category, active, noindex = false,
  canonical: withCanonical = true, jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogTitle = title ?? site.name;
const ldBlocks = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])
  .map((d) => JSON.stringify({ '@context': 'https://schema.org', ...d }).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {withCanonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content={home ? 'website' : 'article'} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  {withCanonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={site.ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Letterly Help Center" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site.ogImage} />
  <meta name="theme-color" content="#FCF4F7" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  {ldBlocks.map((json) => <script type="application/ld+json" set:html={json} />)}
  <script is:inline>
    /* Platform tabs: pick the reader's platform before the page is painted (saved choice, else detected OS). */
    window.__lhPlat = function (el) {
      var keys = [].map.call(el.querySelectorAll('[role=tab]'), function (b) { return b.getAttribute('data-platform'); });
      var pick = null;
      try { pick = localStorage.getItem('lh-platform'); } catch (e) {}
      if (!pick || keys.indexOf(pick) < 0) {
        var ua = navigator.userAgent || '';
        var os = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) ? 'iphone'
          : /Android/.test(ua) ? 'android' : /Macintosh|Mac OS X/.test(ua) ? 'mac' : /Windows/.test(ua) ? 'windows' : 'web';
        pick = keys.indexOf(os) > -1 ? os : keys[0];
      }
      el.querySelectorAll('[role=tab]').forEach(function (b) {
        var on = b.getAttribute('data-platform') === pick;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      el.querySelectorAll('[role=tabpanel]').forEach(function (p) { p.hidden = p.getAttribute('data-platform') !== pick; });
    };
  </script>
</head>
<body class:list={[{ 'home-mode': home }]}>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <div class="layout">
    <Sidebar category={category} active={active} />
    <main class="main" id="main">
      <slot />
    </main>
    <aside class="toc" id="toc" data-pagefind-ignore></aside>
  </div>
  <div class="scrim" id="scrim"></div>
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
